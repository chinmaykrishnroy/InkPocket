bool ext(String s,const char* x){s.toLowerCase();String y=x;y.toLowerCase();return s.endsWith(y);}
String filename(String s){s.replace("\\","/");int p=s.lastIndexOf('/');if(p>=0)s=s.substring(p+1);String r;for(size_t i=0;i<s.length();i++){char c=s[i];if(isalnum(c)||c=='.'||c=='_'||c=='-')r+=c;}return r;}
String fsPath(String s){s.replace("\\","/");if(!s.startsWith("/"))s="/"+s;return s;}
bool pathOK(String p){return p.startsWith("/")&&p.indexOf("..")<0&&(ext(p,".md")||ext(p,".txt")||ext(p,".bmp"));}
String esc(String s){s.replace("\\","\\\\");s.replace("\"","\\\"");s.replace("\n","\\n");s.replace("\r","");return s;}
String randomApPassword(){char value[9];snprintf(value,sizeof(value),"%08lu",(unsigned long)(esp_random()%100000000UL));return String(value);}
String networkIp(){if(radio==PORTAL)return WiFi.softAPIP().toString();if(radio==ONLINE)return WiFi.localIP().toString();return "";}
DeviceUi::RadioMark radioMark(){if(radioBackground&&view!=HOME&&view!=WIFI)return DeviceUi::RadioMark::Off;if(radio==JOINING)return DeviceUi::RadioMark::On;if(radio==ONLINE)return DeviceUi::RadioMark::Client;if(radio==PORTAL)return DeviceUi::RadioMark::AccessPoint;return DeviceUi::RadioMark::Off;}
