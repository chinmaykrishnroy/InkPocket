void mediaUpload(){webActivity();HTTPUpload&u=web.upload();if(u.status==UPLOAD_FILE_START){uploadOk=false;upError="";upSize=0;String n=filename(u.filename);upTarget="/"+n;bool b=ext(n,".bmp");if(!n.length()||!(ext(n,".md")||ext(n,".txt")||b))upError="Only .md, .txt, and BMP files are allowed.";else if(b&&!LittleFS.exists(upTarget)&&bmpCount()>=MAX_BMPS)upError="Five BMP files already exist.";else{uint32_t freeBytes=LittleFS.totalBytes()>LittleFS.usedBytes()+1024?LittleFS.totalBytes()-LittleFS.usedBytes()-1024:0;uploadOk=stagedWriter.begin(LittleFS,upTarget,"/.up.tmp",b?MAX_BMP:MAX_PAYLOAD,freeBytes);if(!uploadOk)upError=stagedWriter.error();}}else if(u.status==UPLOAD_FILE_WRITE&&uploadOk){uploadOk=stagedWriter.write(u.buf,u.currentSize);upSize=stagedWriter.size();if(!uploadOk)upError=stagedWriter.error();}else if(u.status==UPLOAD_FILE_END&&uploadOk){uploadOk=stagedWriter.finishInput();if(uploadOk&&ext(upTarget,".bmp")&&!monoBmp(stagedWriter.inputPath())){uploadOk=false;upError="BMP must be uncompressed 1-bit.";stagedWriter.abort();}else if(uploadOk){uploadOk=stagedWriter.commit();if(!uploadOk)upError=stagedWriter.error();}else upError=stagedWriter.error();if(uploadOk)collectBooks();}else if(u.status==UPLOAD_FILE_ABORTED){stagedWriter.abort();uploadOk=false;upError="Upload cancelled.";}}
