void sleepNow(bool timedRefresh){bool clockSleep=view==CLOCK&&!focus&&!saver;waitForButtonRelease();uint32_t displaySec=UINT32_MAX;if(timedRefresh){uint32_t step=clockSleep?60UL:(saver&&cfg.saverClockMin?(uint32_t)cfg.saverClockMin*60UL:0);displaySec=untilBoundary(step);}uint32_t ntpSec=secondsToNextLocalHour();uint32_t sec=min(displaySec,ntpSec);bool timerEnabled=sec!=UINT32_MAX;bool refreshOnWake=timerEnabled&&displaySec<=ntpSec;timeval now;gettimeofday(&now,nullptr);rtcWakeEpochUs=timeOK()?((int64_t)now.tv_sec*1000000LL+now.tv_usec):0;rtcPlannedSleepUs=timerEnabled?(int64_t)sec*1000000LL:0;rtcMagic=RTC_MAGIC;rtcSaverVisible=saver;esp_sleep_disable_wakeup_source(ESP_SLEEP_WAKEUP_ALL);gpio_wakeup_enable((gpio_num_t)BTN_PIN,GPIO_INTR_LOW_LEVEL);esp_sleep_enable_gpio_wakeup();if(timerEnabled)esp_sleep_enable_timer_wakeup((uint64_t)rtcPlannedSleepUs);display.hibernate();esp_light_sleep_start();esp_sleep_wakeup_cause_t cause=esp_sleep_get_wakeup_cause();display.init(115200,false,2,false);if(cause==ESP_SLEEP_WAKEUP_GPIO){saver=false;rtcSaverVisible=false;if(clockSleep){view=CLOCK;focus=true;}else{view=HOME;focus=false;}ignoreWakeButton=true;refreshPolicy.all();dirty=true;touched=millis();}else if(cause==ESP_SLEEP_WAKEUP_TIMER){if(refreshOnWake){if(clockSleep){view=CLOCK;focus=false;saver=false;refreshRegion(0,28,200,160,true);}else if(saver&&cfg.saverClockMin)refreshRegion(126,168,72,30,true);}wakeAfterRender=true;}}
void minuteRefresh(){uint32_t minute=timeOK()?localEpoch()/60:0;if(!minute||minute==lastMinute)return;lastMinute=minute;if(saver){if(cfg.saverClockMin&&minute%cfg.saverClockMin==0)refreshRegion(126,168,72,30,true);return;}if(view==HOME){refreshRegion(0,0,200,23,true);return;}if(view==CLOCK){tm n;if(local(n)&&lastClockDay!=n.tm_yday){refreshPolicy.all();dirty=true;}else refreshRegion(focus?0:0,focus?35:28,focus?200:100,focus?90:145,true);}}
void idle(){if(toastText.length())return;uint32_t now=millis();minuteRefresh();if(radio==OFF&&hourlySyncDue()){bool resume=wakeAfterRender;wakeAfterRender=false;beginHourlySync(resume);}if(autoScroll&&now-lastScroll>=cfg.scrollSec*1000UL){lastScroll=now;bool moved=false;if(view==BOOK||(view==API&&remote==MARKDOWN))moved=md.scrollDown(160);else if(view==API&&remote==TEXT&&remoteTextMore){rscroll+=160;moved=true;}if(moved){refreshPolicy.all();dirty=true;}else{autoScroll=false;showToast("Auto-scroll finished");}}if(focus&&!saver&&(view==HOME||view==LIST||view==CLOCK||view==SETTINGS)&&now-touched>=cfg.unfocus*1000UL){focus=false;refreshPolicy.all();dirty=true;}if(radio!=OFF||autoScroll)return;if(view==HOME&&!saver&&now-touched>=cfg.saverSec*1000UL){if(cfg.saver){chooseSaver();saver=true;refreshPolicy.all();render(false);sleepNow(cfg.saverClockMin>0);}else sleepNow(false);}else if(view!=HOME&&!saver&&now-touched>=30000){sleepNow(view==CLOCK&&!focus);}}
void setup(){setCpuFrequencyMhz(80);Serial.begin(115200);pinMode(BTN_PIN,INPUT_PULLUP);esp_sleep_wakeup_cause_t wake=esp_sleep_get_wakeup_cause();bool rtcStateValid=rtcMagic==RTC_MAGIC;bool savedSaver=rtcStateValid&&rtcSaverVisible;if(!rtcStateValid){rtcWakeEpochUs=0;rtcPlannedSleepUs=0;lastNtpAttemptHour=UINT32_MAX;lastNtpSuccessHour=UINT32_MAX;rtcSaverVisible=false;}pref.begin("ereader",false);bool resumeOtaWeb=pref.getBool("ota_resume",false);if(resumeOtaWeb)pref.remove("ota_resume");loadCfg();bool fsReady=LittleFS.begin(false);if(!fsReady)error("LittleFS mount failed");display.init(115200,false,2,false);md.begin();routes();if(wake==ESP_SLEEP_WAKEUP_TIMER&&rtcStateValid&&rtcWakeEpochUs>1704067200000000LL){int64_t restored=rtcWakeEpochUs+rtcPlannedSleepUs;timeval tv={(time_t)(restored/1000000LL),(suseconds_t)(restored%1000000LL)};settimeofday(&tv,nullptr);}if(fsReady){recoverStagedFiles();ensureExamples();}collectBooks();touched=millis();if(wake==ESP_SLEEP_WAKEUP_TIMER&&savedSaver){saver=true;render(false);sleepNow(true);}if(savedSaver&&wake!=ESP_SLEEP_WAKEUP_TIMER){saver=false;rtcSaverVisible=false;view=HOME;focus=false;dirty=true;}render(true);if(resumeOtaWeb)startWifi(true);else if(!timeOK()&&wake==ESP_SLEEP_WAKEUP_UNDEFINED)startWifi(false);}
