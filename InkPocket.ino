void showOtaProgress(){header("InkPocket update");uint8_t percent=ota.percent();centred(ota.message.length()?ota.message:"Writing firmware",56);String amount=ota.total?String(percent)+"%":String(ota.written/1024)+" KB";DeviceUi::faceInRect(display,amount,ota.total?&FreeMonoBold24pt7b:&FreeMonoBold9pt7b,10,68,180,42);display.drawRoundRect(14,116,172,20,4,GxEPD_BLACK);if(ota.total&&percent){int width=(168*percent)/100;display.fillRoundRect(16,118,width,16,2,GxEPD_BLACK);}if(ota.total)centred(String(ota.written/1024)+" / "+String(ota.total/1024)+" KB",151);else centred("Receiving firmware",151);centred("Keep power connected",174);}
void renderOta(bool immediate=false){uint8_t step=ota.displayStep();if(!immediate&&ota.screenReady&&step==ota.shownStep&&millis()-ota.lastDraw<1500)return;if(ota.screenReady)display.setPartialWindow(0,0,200,200);else display.setFullWindow();display.firstPage();do{display.fillScreen(GxEPD_WHITE);showOtaProgress();}while(display.nextPage());ota.screenReady=true;ota.shownStep=step;ota.lastDraw=millis();dirty=false;}
void beginOtaProgress(uint32_t total){ota.begin(total);saver=false;focus=false;touched=millis();renderOta(true);}
void updateOtaProgress(uint32_t written,uint32_t total=0){ota.written=written;if(total)ota.total=total;ota.lastActivity=millis();ota.message="Writing firmware";renderOta(false);}
void finishOtaProgress(){if(!ota.total)ota.total=ota.written;ota.written=max(ota.written,ota.total);ota.ok=true;ota.verified=true;ota.lastActivity=millis();ota.message="Firmware verified";pref.putBool("ota_resume",true);rebootAt=millis()+2500;renderOta(true);}
void failOtaProgress(String message){ota.ok=false;ota.verified=false;ota.lastActivity=millis();ota.message=message;renderOta(true);ota.active=false;touched=millis();}
void otaLoop(){if(ota.active&&!ota.verified&&millis()-ota.lastActivity>45000){Update.abort();failOtaProgress("Update timed out");}}
