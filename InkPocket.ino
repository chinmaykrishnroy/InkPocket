void buttonLoop(){bool down=digitalRead(BTN_PIN)==LOW;uint32_t now=millis();if(ota.active){if(down&&!btnOld){press=now;longDone=false;}if(down&&!longDone&&!ota.verified&&now-press>=5000){Update.abort();failOtaProgress("Update cancelled");longDone=true;}btnOld=down;return;}if(ignoreWakeButton){if(!down){ignoreWakeButton=false;btnOld=false;clicks=0;}else btnOld=true;return;}if(down&&!btnOld){press=now;longDone=false;}uint32_t limit=view==HOME?5000:cfg.hold;if(down&&!longDone&&now-press>=limit){if(!focus&&view!=HOME)wakeUI();else if(view==HOME){startWifi(true);dirty=true;}else goBack();longDone=true;clicks=0;}if(!down&&btnOld){release=now;if(!longDone&&now-press>=35)clicks++;}if(!down&&clicks&&now-release>340){uint16_t n=clicks;clicks=0;if(n==1)single();else if(n==2)doubleClick();else if(n==3)triple();}btnOld=down;}
uint32_t untilBoundary(uint32_t interval){if(!timeOK()||!interval)return UINT32_MAX;uint32_t past=(uint32_t)localEpoch()%interval;return past?interval-past:interval;}
