void otaUpload(){webActivity();HTTPUpload&u=web.upload();if(u.status==UPLOAD_FILE_START){uint32_t total=web.hasArg("size")?(uint32_t)strtoul(web.arg("size").c_str(),nullptr,10):0;beginOtaProgress(total);ota.ok=Update.begin(UPDATE_SIZE_UNKNOWN,U_FLASH);if(ota.ok){ota.message="Writing firmware";renderOta(true);}else failOtaProgress("Cannot start update");}else if(u.status==UPLOAD_FILE_WRITE&&ota.ok){size_t written=Update.write(u.buf,u.currentSize);ota.written+=written;if(written!=u.currentSize)failOtaProgress("Firmware write failed");else updateOtaProgress(ota.written);}else if(u.status==UPLOAD_FILE_END&&ota.ok){ota.message="Verifying firmware";renderOta(true);ota.ok=Update.end(true);if(ota.ok)finishOtaProgress();else failOtaProgress("Verification failed");}else if(u.status==UPLOAD_FILE_ABORTED){Update.abort();failOtaProgress("Transfer cancelled");}}
