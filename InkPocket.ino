void render(bool force=false){if(ota.active){renderOta(force);return;}bool armToast=toastText.length()&&!toastUntil;bool autoFull=refreshPolicy.automatic&&automaticPartials>=60;bool all=force||autoFull||(!refreshPolicy.automatic&&partials>=cfg.fullAfter);if(all){display.setFullWindow();partials=0;automaticPartials=0;}else if(refreshPolicy.regional){display.setPartialWindow(refreshPolicy.x,refreshPolicy.y,refreshPolicy.width(),refreshPolicy.height());if(refreshPolicy.automatic)automaticPartials++;else partials++;}else{display.setPartialWindow(0,0,200,200);partials++;}display.firstPage();do{display.fillScreen(GxEPD_WHITE);if(saver)showSaver();else if(view==HOME)showHome();else if(view==LIST)showList();else if(view==BOOK)showMd(opened);else if(view==CLOCK)showClock();else if(view==API)showApi();else if(view==SETTINGS)showSettings();else showWifi();if(errorText.length()&&!saver&&view!=WIFI){String e=errorText.length()>30?errorText.substring(0,27)+"...":errorText;display.fillRoundRect(3,158,194,19,3,GxEPD_WHITE);display.drawRoundRect(3,158,194,19,3,GxEPD_BLACK);display.setCursor(7,164);display.print("! "+e);}if(toastText.length()&&!saver)DeviceUi::toast(display,toastText);}while(display.nextPage());if(armToast)toastUntil=millis()+1000;dirty=false;refreshPolicy.all();}

void startWeb(){webTouched=millis();if(!webOn){web.begin();webOn=true;}if(!otaOn){ArduinoOTA.setHostname("inkpocket");ArduinoOTA.onStart([](){webActivity();beginOtaProgress(0);ota.ok=true;ota.message="Receiving Arduino OTA";renderOta(true);});ArduinoOTA.onProgress([](unsigned int progress,unsigned int total){webActivity();updateOtaProgress(progress,total);});ArduinoOTA.onEnd([](){finishOtaProgress();});ArduinoOTA.onError([](ota_error_t){failOtaProgress("Arduino OTA failed");});ArduinoOTA.begin();otaOn=true;}}
void stopWeb(){if(otaOn){ArduinoOTA.end();otaOn=false;}if(webOn){web.stop();webOn=false;}}
void radioVisualChanged(){if(saver)return;if(view==HOME)refreshRegion(0,0,200,23);else if(view==WIFI){refreshPolicy.all();dirty=true;}}
void timeVisualChanged(){if(saver&&cfg.saverClockMin)refreshRegion(126,168,72,30,true);else if(view==HOME)refreshRegion(0,0,200,23,true);else if(view==CLOCK){refreshPolicy.all();dirty=true;}}
uint32_t localHour(){return timeOK()?(uint32_t)(localEpoch()/3600):UINT32_MAX;}
uint32_t secondsToNextLocalHour(){if(!timeOK())return UINT32_MAX;uint32_t past=(uint32_t)localEpoch()%3600;return past?3600-past:3600;}
bool hourlySyncDue(){uint32_t hour=localHour();return hour!=UINT32_MAX&&hour!=lastNtpAttemptHour;}
void markNtpAttempt(){lastNtpAttemptHour=localHour();}
void ntpSyncComplete(struct timeval*){ntpSynced=true;}
void startPortal(){radioPolicy.purpose=RadioPurpose::Setup;radioBackground=false;resumeSleepAfterSync=false;if(view!=WIFI)backView=view;view=WIFI;dns.stop();stopWeb();WiFi.disconnect(false);WiFi.mode(WIFI_AP);apPassword=randomApPassword();WiFi.softAP(AP_SSID,apPassword.c_str());dns.start(53,"*",WiFi.softAPIP());radio=PORTAL;startWeb();errorText="";Serial.println("[wifi] Setup AP ready at "+WiFi.softAPIP().toString());refreshPolicy.all();dirty=true;}
void startWifi(bool keep,bool background=false,bool usePending=false){toastText="";toastUntil=0;wifiPinned=keep;radioBackground=background;radioPolicy.purpose=background?RadioPurpose::TimeSync:RadioPurpose::Web;if(!background){backView=view;view=WIFI;}String network=usePending?pendingSsid:savedSsid();String networkPassword=usePending?pendingPassword:savedPassword();if(!network.length()){if(background){bool resume=resumeSleepAfterSync;radioBackground=false;resumeSleepAfterSync=false;radioPolicy.purpose=RadioPurpose::None;if(resume)wakeAfterRender=true;return;}startPortal();return;}stopWeb();WiFi.mode(WIFI_STA);WiFi.setSleep(true);WiFi.begin(network.c_str(),networkPassword.c_str());radio=JOINING;joining=millis();radioVisualChanged();}
void stopWifi(bool notify=true){bool wasOn=radio!=OFF;dns.stop();stopWeb();WiFi.softAPdisconnect(true);WiFi.disconnect(false);WiFi.mode(WIFI_OFF);radio=OFF;wifiPinned=false;radioBackground=false;radioPolicy.purpose=RadioPurpose::None;radioVisualChanged();if(wasOn&&notify)showToast("Radio Off");}
void startNtp(){if(radio==ONLINE){markNtpAttempt();ntpSynced=false;sntp_stop();sntp_set_sync_mode(SNTP_SYNC_MODE_IMMED);sntp_set_time_sync_notification_cb(ntpSyncComplete);configTime(0,0,"pool.ntp.org","time.nist.gov","time.google.com");ntp=true;ntpAt=millis();}}
void beginHourlySync(bool resumeSleep){markNtpAttempt();resumeSleepAfterSync=resumeSleep;startWifi(false,true);}
void finishBackgroundSync(bool synced){bool resume=resumeSleepAfterSync;resumeSleepAfterSync=false;stopWifi(false);if(synced)timeVisualChanged();if(resume)wakeAfterRender=true;}
void radioLoop(){if(radio==PORTAL)dns.processNextRequest();if(radio==ONLINE&&WiFi.status()!=WL_CONNECTED&&!ota.active){radio=JOINING;joining=millis();WiFi.reconnect();radioVisualChanged();}if(radio==JOINING){if(WiFi.status()==WL_CONNECTED){radio=ONLINE;if(credentialsPending){pref.putString("ssid",pendingSsid);pref.putString("pass",pendingPassword);pref.putBool("wifi_custom",true);credentialsPending=false;pendingSsid="";pendingPassword="";showToast("Wi-Fi saved");}if(radioBackground)startNtp();else{startWeb();startNtp();}errorText="";radioVisualChanged();}else{uint32_t limit=radioBackground?RadioPolicy::kBackgroundJoinMs:RadioPolicy::kManualJoinMs;if(millis()-joining>limit){if(radioBackground)finishBackgroundSync(false);else{if(credentialsPending){credentialsPending=false;pendingSsid="";pendingPassword="";showToast("Previous Wi-Fi kept");}startPortal();}}}}if(radio==ONLINE&&otaOn)ArduinoOTA.handle();if(ntp&&radio==ONLINE){if(ntpSynced){ntp=false;ntpSynced=false;lastNtpSuccessHour=localHour();if(radioBackground)finishBackgroundSync(true);else if(!wifiPinned){View prior=backView;stopWifi();view=prior;refreshPolicy.all();dirty=true;}else timeVisualChanged();}else if(millis()-ntpAt>RadioPolicy::kNtpTimeoutMs){ntp=false;if(radioBackground)finishBackgroundSync(false);else{error("NTP sync failed");if(!wifiPinned){View prior=backView;stopWifi();view=prior;refreshPolicy.all();dirty=true;}}}}if((radio==ONLINE||radio==PORTAL)&&!ota.active){uint32_t limit=radio==PORTAL?RadioPolicy::kSetupIdleMs:RadioPolicy::kWebIdleMs;if(millis()-webTouched>=limit){bool wifiView=view==WIFI;stopWifi();resumeSleepAfterSync=false;if(wifiView)view=backView;refreshPolicy.all();dirty=true;}}}

