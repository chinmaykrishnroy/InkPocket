void loadCfg(){cfg.unfocus=constrain(pref.getUChar("unfocus",10),2,10);uint16_t st=pref.getUShort("saver_sec",30);cfg.saverSec=(st==15||st==30||st==60||st==120)?st:30;uint16_t h=pref.getUShort("hold",750);cfg.hold=(h==500||h==750||h==1000||h==1500)?h:750;cfg.fullAfter=constrain(pref.getUChar("partial",10),5,15);cfg.twelve=pref.getBool("twelve",false);cfg.saver=pref.getBool("saver",true);cfg.scrollSec=constrain(pref.getUChar("scroll",10),5,60);uint8_t sc=pref.getUChar("saver_clock",5);cfg.saverClockMin=(sc==0||sc==1||sc==5||sc==10)?sc:5;cfg.utc=constrain(pref.getShort("utc",330),-720,840);}
void saveCfg(){pref.putUChar("unfocus",cfg.unfocus);pref.putUShort("saver_sec",cfg.saverSec);pref.putUShort("hold",cfg.hold);pref.putUChar("partial",cfg.fullAfter);pref.putBool("twelve",cfg.twelve);pref.putBool("saver",cfg.saver);pref.putUChar("scroll",cfg.scrollSec);pref.putUChar("saver_clock",cfg.saverClockMin);pref.putShort("utc",cfg.utc);}
bool timeOK(){return time(nullptr)>1704067200;} time_t localEpoch(){return time(nullptr)+(time_t)cfg.utc*60;}
bool local(tm& o){if(!timeOK())return false;time_t n=localEpoch();gmtime_r(&n,&o);return true;} String two(int n){return n<10?"0"+String(n):String(n);}
String clockString(bool force24=false){tm n;if(!local(n))return "--:--";int h=n.tm_hour;String ap;if(cfg.twelve&&!force24){ap=h>=12?" PM":" AM";h%=12;if(!h)h=12;}return two(h)+":"+two(n.tm_min)+ap;}
String headerClockString(){tm n;if(!local(n))return "--:--";int h=n.tm_hour;if(cfg.twelve){h%=12;if(!h)h=12;}return two(h)+":"+two(n.tm_min);}
String dateString(){tm n;if(!local(n))return "Time not synced";char b[32];strftime(b,sizeof(b),"%a, %d %b %Y",&n);return b;}
String savedSsid(){return pref.getBool("wifi_custom",false)?pref.getString("ssid",ssid):String(ssid);}String savedPassword(){return pref.getBool("wifi_custom",false)?pref.getString("pass",password):String(password);}
void collectBooks(){books=0;File root=LittleFS.open("/");for(File f=root?root.openNextFile():File();f&&books<32;f=root.openNextFile()){if(!f.isDirectory()&&ext(f.name(),".md"))files[books++]=fsPath(f.name());f.close();}if(root)root.close();for(uint8_t i=0;i<books;i++)for(uint8_t j=i+1;j<books;j++)if(files[j]<files[i]){String t=files[i];files[i]=files[j];files[j]=t;}if(book>=books)book=0;}
bool writeBundledFile(const char* path,const uint8_t* bytes,size_t length){File f=LittleFS.open(path,"w");if(!f)return false;size_t written=f.write(bytes,length);f.close();return written==length;}
void ensureExamples(){bool refreshBmp=pref.getUChar("asset_ver",0)<kBundledAssetVersion;if(refreshBmp||!LittleFS.exists("/test.bmp")){if(writeBundledFile("/test.bmp",kTestBmp,kTestBmpSize))pref.putUChar("asset_ver",kBundledAssetVersion);else error("Could not add test.bmp");}if(!LittleFS.exists("/EReader.md")){File f=LittleFS.open("/EReader.md","w");if(!f||!f.print(kExampleMarkdown)){if(f)f.close();error("Could not add EReader.md");return;}f.close();}}
void recoverStagedFiles(){LittleFS.remove("/.up.tmp");LittleFS.remove("/.api.tmp");LittleFS.remove("/.api.txt.tmp");LittleFS.remove("/.api.md.tmp");LittleFS.remove("/.api.bmp.tmp");File root=LittleFS.open("/");for(File f=root?root.openNextFile():File();f;f=root.openNextFile()){String name=fsPath(f.name());f.close();if(!name.endsWith(".bak"))continue;String target=name.substring(0,name.length()-4);if(pathOK(target)||target.startsWith("/.api.")){if(LittleFS.exists(target))LittleFS.remove(name);else LittleFS.rename(name,target);}}if(root)root.close();}
uint8_t bmpCount(){uint8_t n=0;File r=LittleFS.open("/");for(File f=r?r.openNextFile():File();f;f=r.openNextFile()){if(!f.isDirectory()&&ext(f.name(),".bmp"))n++;f.close();}if(r)r.close();return n;}
