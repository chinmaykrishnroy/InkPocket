void showSettings(){header(edit?"EDIT SETTING":"SETTINGS");int start=setting>=5?setting-4:0;for(int i=0;i<5&&start+i<11;i++){int n=start+i,y=28+i*32;bool on=focus&&n==setting;if(on){display.fillRoundRect(4,y,192,28,4,GxEPD_BLACK);display.setTextColor(GxEPD_WHITE);}else display.drawRoundRect(4,y,192,28,4,GxEPD_BLACK);display.setCursor(10,y+5);display.print(setName(n));display.setCursor(10,y+16);display.print(setVal(n));font();}}
