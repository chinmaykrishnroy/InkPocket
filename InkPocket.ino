void changeSetting(){if(setting==0)cfg.unfocus=cfg.unfocus>=10?2:cfg.unfocus+1;else if(setting==1)cfg.saverSec=cfg.saverSec<30?30:cfg.saverSec<60?60:cfg.saverSec<120?120:15;else if(setting==2)cfg.saverClockMin=cfg.saverClockMin==0?1:cfg.saverClockMin==1?5:cfg.saverClockMin==5?10:0;else if(setting==3){const uint16_t x[]={500,750,1000,1500};uint8_t n=0;while(n<3&&x[n]!=cfg.hold)n++;cfg.hold=x[(n+1)%4];}else if(setting==4)cfg.fullAfter=cfg.fullAfter>=15?5:cfg.fullAfter+1;else if(setting==5)cfg.twelve=!cfg.twelve;else if(setting==6)cfg.saver=!cfg.saver;else if(setting==7)cfg.scrollSec=cfg.scrollSec>=60?5:cfg.scrollSec+5;else if(setting==8){cfg.utc+=30;if(cfg.utc>840)cfg.utc=-720;}}
bool dismissSaver(){if(!saver)return false;saver=false;rtcSaverVisible=false;view=HOME;focus=false;dirty=true;touched=millis();return true;}
