void doubleClick(){if(dismissSaver())return;if(!focus){wakeUI();return;}wakeUI();if(view==HOME){if(home==0){collectBooks();view=LIST;focus=true;}else if(home==1)view=CLOCK;else if(home==2){remote=NONE;view=API;}else view=SETTINGS;}else if(view==LIST&&books){opened=files[book];md.resetScroll();view=BOOK;}else if(view==BOOK){md.scrollUp(160);autoScroll=false;}else if(view==API){if(remote==MARKDOWN)md.scrollUp(160);else if(remote==TEXT)rscroll=max(0,rscroll-160);autoScroll=false;}else if(view==SETTINGS){if(edit){saveCfg();edit=false;}else if(setting<=8)edit=true;else if(setting==9){if(radio==ONLINE)startNtp();else startWifi(false);}else{if(radio==OFF){backView=SETTINGS;startWifi(true);view=WIFI;}else stopWifi();}}}
